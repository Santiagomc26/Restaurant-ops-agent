# --- Aplicación ---
APP_NAME="Restaurant Ops Agent"
APP_ENV=development
LOG_LEVEL=INFO
RESTAURANT_TIMEZONE=America/Bogota

# --- Base de datos ---
# SQLite para desarrollo local. Para PostgreSQL:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/restaurant_ops
DATABASE_URL=sqlite:///./data/restaurant.db

# --- Agente local (Ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_TIMEOUT_SECONDS=120

# --- Canal de mensajería ---
# simulator: prueba el agente sin gastar mensajes de WhatsApp
# whatsapp: usa WhatsApp Cloud API (Meta)
MESSAGING_CHANNEL=simulator
WHATSAPP_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
