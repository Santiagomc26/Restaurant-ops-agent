# --- Aplicación ---
APP_NAME="Restaurant Ops Agent"
APP_ENV=development
LOG_LEVEL=INFO
RESTAURANT_TIMEZONE=America/Bogota

# --- PostgreSQL (docker compose lee estas variables) ---
POSTGRES_USER=restaurant
POSTGRES_PASSWORD=restaurant
POSTGRES_DB=restaurant_ops
POSTGRES_PORT=5432

# --- pgAdmin (http://localhost:5050) ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# --- Base de datos de la API ---
# PostgreSQL en Docker (recomendado):
DATABASE_URL=postgresql+psycopg://restaurant:restaurant@localhost:5432/restaurant_ops
# Sin Docker, con SQLite:
# DATABASE_URL=sqlite:///./data/restaurant.db

# --- Agente local (Ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_TIMEOUT_SECONDS=120

# --- Canal de mensajería ---
# simulator: prueba el agente sin gastar mensajes de WhatsApp
# whatsapp: usa WhatsApp Cloud API (Meta)
MESSAGING_CHANNEL=simulator
WHATSAPP_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
